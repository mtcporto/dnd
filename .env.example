# Required. Use the project's dedicated Turso database; never a database from another app.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001
# Google OAuth is enabled only when BOTH values are configured.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional provider for future AI assistance. Chat Completions compatible; no API key required.
AI_BASE_URL=https://copilot-mtcporto.vercel.app/v1/
AI_MODEL=gpt-4o
