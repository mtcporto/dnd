# Required. Use the project's dedicated Turso database; never a database from another app.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001
# Google OAuth is enabled only when BOTH values are configured.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional provider for future AI assistance. Chat Completions compatible; no API key required.
AI_BASE_URL=https://copilot-mtcporto.vercel.app/v1/
AI_MODEL=gpt-4o

# Preferred translation provider when its key is configured. Server-only.
OLLAMA_BASE_URL=https://ollama.com/v1/
OLLAMA_MODEL=gpt-oss:120b
OLLAMA_API_KEY=

# Image publishing scripts only; the website uses public URLs from versioned manifests.
R2_ACCOUNT_ID=
R2_BUCKET_NAME=dnd-images
R2_PUBLIC_URL=https://dnd-images.mosaicoworkers.workers.dev
R2_UPLOAD_URL=https://dnd-images.mosaicoworkers.workers.dev
R2_UPLOAD_TOKEN=
