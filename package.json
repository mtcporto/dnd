{
  "name": "dnd-adventures",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3001",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3001",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app components lib domain server",
    "test": "node --test tests/*.test.cjs",
    "catalogue:update": "node scripts/import-catalogue.cjs && npm run catalogue:translate",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env.local scripts/migrate.cjs",
    "verify:flow": "node --env-file=.env.local scripts/verify-flow.cjs",
    "catalogue:translate": "node --env-file=.env.local scripts/collect-ui-texts.cjs && node --env-file=.env.local scripts/localize-catalogue.cjs"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.7",
    "@libsql/client": "^0.18.0",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.4",
    "motion": "^14.1.0",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  },
  "type": "module"
}
